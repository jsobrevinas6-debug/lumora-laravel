+    public function replacePaymentProof(Request $request, string $orderId): JsonResponse
+    {
+        $order = $this->findBuyerOrder($request, $orderId);
+
+        if (! in_array($order->payment_method, ['gcash', 'maya', 'paymaya'], true)
+            || $order->payment_status !== 'pending'
+            || $order->status !== 'pending') {
+            return response()->json(['message' => 'Only pending e-wallet orders can update their payment proof.'], 422);
+        }
+
+        $validated = $request->validate([
+            'payment_proof' => ['required', 'image', 'mimes:jpg,jpeg,png,webp', 'max:5120'],
+            'payment_reference_last6' => ['required', 'regex:/^\d{6}$/'],
+        ]);
+
+        $diskName = config('filesystems.payment_proof_disk');
+        $disk = \Illuminate\Support\Facades\Storage::disk($diskName);
+        $previousPath = $order->payment_proof_path;
+        $newPath = $request->file('payment_proof')->store('payment-proofs', $diskName);
+
+        if (! $newPath) {
+            return response()->json(['message' => 'The receipt could not be saved. Please try again.'], 500);
+        }
+
+        $order->update([
+            'payment_proof_path' => $newPath,
+            'payment_reference_last6' => $validated['payment_reference_last6'],
+        ]);
+
+        if ($previousPath && $previousPath !== $newPath && $disk->exists($previousPath)) {
+            $disk->delete($previousPath);
+        }
+
+        return response()->json(['message' => 'Your payment receipt was submitted for review.']);
+    }
